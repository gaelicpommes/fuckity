# Export a high-resolution side view of the 10 cm applicator and water phantom.
# Geometry only: this macro does not run any particles.
/control/verbose 1
/run/verbose 0
/flash/setApplicatorIDcm 10
/run/initialize

/vis/open OGLSQt 3000x2000-0+0
/vis/scene/create
/vis/scene/add/volume
/vis/drawVolume
/vis/viewer/set/style surface
/vis/viewer/set/background 0.03 0.04 0.07
/vis/viewer/set/viewpointThetaPhi 90 0 deg
/vis/viewer/set/targetPoint 0 0 300 mm
/vis/viewer/set/auxiliaryEdge true
/vis/viewer/set/lineSegmentsPerCircle 100
/vis/viewer/zoom 1.15
/vis/viewer/flush
/vis/ogl/export beamline_10cm_geometry_300dpi.png
